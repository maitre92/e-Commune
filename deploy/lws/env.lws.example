# .env de PRODUCTION (LWS) — copié vers ~/e-commune_app/.env au premier déploiement, puis complété À LA MAIN.
# Ne jamais versionner le .env réel.

APP_NAME="e-Commune"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://e-commune.VOTRE-DOMAINE

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Bamako

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Base créée dans cPanel (MySQL Databases) : les noms sont préfixés par le compte (c2823388c_...).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=c2823388c_e-commune
DB_USERNAME=c2823388c_e-commune
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@VOTRE-DOMAINE"
MAIL_FROM_NAME="${APP_NAME}"

# Superadmins créés automatiquement s'ils n'existent pas. Mot de passe FORT : il est temporaire
# (changement forcé à la première connexion, APP_ENV != local).
SUPERADMIN_PASSWORD=
SUPERADMIN_1_NAME=
SUPERADMIN_1_PHONE=
SUPERADMIN_2_NAME=
SUPERADMIN_2_PHONE=

# Mairie de cette installation (page de connexion). Vide : la seule mairie active.
MAIRIE_ID=

# Adresse de contact affichée sur la politique de confidentialité (/confidentialite, fiche Play Store).
APP_CONTACT_EMAIL=
