{
  "expo": {
    "name": "e-Commune",
    "slug": "e-commune",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ecommune",
    "userInterfaceStyle": "light",
    "android": {
      "package": "ml.ecommune.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#0f5132"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0f5132"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "e-Commune utilise vos photos pour votre photo de profil.",
          "cameraPermission": "e-Commune utilise l'appareil photo pour votre photo de profil.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b2dc8cc-96f3-40a5-bd1d-3a008e205995"
      }
    },
    "description": "Application des agents de mairie : vignettes de motos, actes de naissance et de mariage, caisse.",
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "owner": "maitrebarry"
  }
}
