{
  "name": "e-commune-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export --platform android",
    "build:apk": "eas build --platform android --profile preview",
    "build:play": "eas build --platform android --profile production",
    "submit:play": "eas submit --platform android --profile production --latest",
    "store:images": "node store/source/render.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "axios": "^1.20.0",
    "expo": "~57.0.33",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.22",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.14",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.32",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
